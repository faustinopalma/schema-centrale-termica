<?xml version="1.0" encoding="UTF-8"?><mxfile host="Electron" agent="Plant documentation" version="24.0.0"><diagram id="page-0" name="One plant, three separate water systems"><mxGraphModel dx="1260" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="750" background="#f7f4ef"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="One plant, three separate water systems" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=27;fontStyle=1;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1180" height="45" as="geometry"/></mxCell><mxCell id="subtitle" value="Energy-flow overview | arrows represent heat transfer, not pipe connections" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=15;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="1180" height="36" as="geometry"/></mxCell><mxCell id="wells" value="&lt;b&gt;GROUNDWATER&lt;/b&gt;&lt;br&gt;Wells P1 / P2 + T6 / T7 / S4&lt;br&gt;Source in winter; sink in summer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="240" height="110" as="geometry"/></mxCell><mxCell id="pc2" value="&lt;b&gt;2 x PC2 | HiRef MSW&lt;/b&gt;&lt;br&gt;Water-to-water heat pumps&lt;br&gt;Building + intermediate circuits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#b11f4b;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="400" y="185" width="240" height="110" as="geometry"/></mxCell><mxCell id="hvac" value="&lt;b&gt;BUILDING HEATING / COOLING&lt;/b&gt;&lt;br&gt;S3 buffers + distribution branches&lt;br&gt;Radiant panels and other loads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="930" y="185" width="270" height="110" as="geometry"/></mxCell><mxCell id="warm" value="&lt;b&gt;INTERMEDIATE WATER&lt;/b&gt;&lt;br&gt;2 x S3, each 2,000 L&lt;br&gt;40 / 35 deg C design labels" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="400" y="430" width="240" height="110" as="geometry"/></mxCell><mxCell id="pc1" value="&lt;b&gt;PC1 | HiRef KSW&lt;/b&gt;&lt;br&gt;High-temperature heat pump&lt;br&gt;70 / 65 deg C primary loop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#b11f4b;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="220" height="110" as="geometry"/></mxCell><mxCell id="dhw" value="&lt;b&gt;DOMESTIC HOT WATER&lt;/b&gt;&lt;br&gt;2 x SC1 + 2 x S2 (3,000 L each)&lt;br&gt;60 deg C storage; mixed outlets" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="940" y="430" width="260" height="110" as="geometry"/></mxCell><mxCell id="edge-ground" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#0078d4;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="wells" target="pc2"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-ground" value="Source / sink" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="210" y="197" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-space" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#16a34a;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="pc2" target="hvac"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-space" value="Heating / cooling" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="655" y="197" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-recovery" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#f59e0b;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="pc2" target="warm"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-recovery" value="Warm-water production / recovery" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="570" y="349" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-lift" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#f59e0b;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="warm" target="pc1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge-hot" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#b11f4b;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="pc1" target="dhw"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="foot-0" value="PC2 and PC1 also consume electricity. Heat crosses exchanger surfaces; the water systems remain separate." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="654" width="1180" height="25" as="geometry"/></mxCell><mxCell id="foot-1" value="S00 p.1 + S01/S02 family principles. Recovery availability and priority depend on the installed configuration." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="679" width="1180" height="25" as="geometry"/></mxCell><mxCell id="foot-2" value="Groundwater and building arrows reverse between heating and cooling. Service devices are omitted." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="704" width="1180" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="Domestic hot water: follow one pressure branch"><mxGraphModel dx="1260" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="790" background="#f7f4ef"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="Domestic hot water: follow one pressure branch" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=27;fontStyle=1;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1180" height="45" as="geometry"/></mxCell><mxCell id="subtitle" value="Simplified water-flow principle | repeat for MP (P02) and BP (P03); each has its own SC1, P01 and S2" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=15;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="1180" height="36" as="geometry"/></mxCell><mxCell id="dhw-pc1" value="&lt;b&gt;PC1 + P04&lt;/b&gt;&lt;br&gt;Closed hot-water primary&lt;br&gt;70 supply / 65 return" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#b11f4b;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="210" height="110" as="geometry"/></mxCell><mxCell id="dhw-sc1" value="&lt;b&gt;SC1 | 90 kW&lt;/b&gt;&lt;br&gt;Heat-exchanger boundary&lt;br&gt;No mixing of the fluids" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#b11f4b;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="350" y="210" width="210" height="110" as="geometry"/></mxCell><mxCell id="dhw-s2" value="&lt;b&gt;S2 | 3,000 L&lt;/b&gt;&lt;br&gt;Potable hot-water storage&lt;br&gt;60 deg C design label" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="670" y="210" width="210" height="110" as="geometry"/></mxCell><mxCell id="dhw-mix" value="&lt;b&gt;MIXING VALVE&lt;/b&gt;&lt;br&gt;Hot + cold blending&lt;br&gt;48 deg C outlet label" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="980" y="210" width="220" height="110" as="geometry"/></mxCell><mxCell id="dhw-return" value="&lt;b&gt;P02 or P03&lt;/b&gt;&lt;br&gt;Dedicated recirculation pump&lt;br&gt;3.6 m3/h design duty" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="350" y="455" width="210" height="110" as="geometry"/></mxCell><mxCell id="dhw-cold" value="&lt;b&gt;TREATED COLD WATER&lt;/b&gt;&lt;br&gt;Pressure-zone supply&lt;br&gt;T2 + T3 + T4 upstream" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="670" y="455" width="210" height="110" as="geometry"/></mxCell><mxCell id="dhw-users" value="&lt;b&gt;DHW DISTRIBUTION&lt;/b&gt;&lt;br&gt;Draw-off to taps&lt;br&gt;Separate recirculation return" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#0078d4;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="980" y="455" width="220" height="110" as="geometry"/></mxCell><mxCell id="edge-hot-supply" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#b11f4b;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.2727272727272727;entryX=0;entryY=0.2727272727272727;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-pc1" target="dhw-sc1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-hot-supply" value="70 deg C" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="170" y="203" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-hot-return" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#b11f4b;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0;exitY=0.7272727272727273;entryX=1;entryY=0.7272727272727273;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-sc1" target="dhw-pc1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-hot-return" value="65 deg C" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="170" y="297" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-charge" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#0078d4;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.2727272727272727;entryX=0;entryY=0.2727272727272727;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-sc1" target="dhw-s2"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-charge" value="60 deg C" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="485" y="203" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-charge-return" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#0078d4;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0;exitY=0.7272727272727273;entryX=1;entryY=0.7272727272727273;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-s2" target="dhw-sc1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-charge-return" value="P01 / 55 deg C" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="485" y="318" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-stored-hot" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#0078d4;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.2727272727272727;entryX=0;entryY=0.2727272727272727;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-s2" target="dhw-mix"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-stored-hot" value="Hot water" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="800" y="203" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-mixed-water" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#0078d4;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-mix" target="dhw-users"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-mixed-water" value="Mixed supply" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="1100" y="381" width="140" height="23" as="geometry"/></mxCell><mxCell id="edge-tank-fill" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#0078d4;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-cold" target="dhw-s2"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="label-tank-fill" value="Cold feed" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="589" y="379" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-mix-cold" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#0078d4;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1;exitY=0.4090909090909091;entryX=0;entryY=0.7272727272727273;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-cold" target="dhw-mix"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="500"/><mxPoint x="930" y="290"/></Array></mxGeometry></mxCell><mxCell id="label-mix-cold" value="Cold blend" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="870" y="346" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-recirc" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#0078d4;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-users" target="dhw-return"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="625"/><mxPoint x="455" y="625"/></Array></mxGeometry></mxCell><mxCell id="label-recirc" value="Return from the same pressure zone" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="640" y="631" width="260" height="23" as="geometry"/></mxCell><mxCell id="edge-recirc-join" style="edgeStyle=none;html=0;rounded=0;strokeWidth=2;strokeColor=#0078d4;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0.09523809523809523;entryY=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="dhw-return" target="dhw-s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="510"/><mxPoint x="610" y="380"/><mxPoint x="690" y="380"/></Array></mxGeometry></mxCell><mxCell id="foot-0" value="Rose: closed PC1 primary water. Blue: potable water. The two fluids exchange heat across SC1." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="694" width="1180" height="25" as="geometry"/></mxCell><mxCell id="foot-1" value="The recirculation connection is simplified; the source includes a split return/mixing arrangement." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="719" width="1180" height="25" as="geometry"/></mxCell><mxCell id="foot-2" value="S00 p.1, two DHW branches. Temperatures are drawing annotations; hygiene and operating settings need verification." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=14;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="744" width="1180" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="Heating and cooling: distribution by pressure zone"><mxGraphModel dx="1260" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1000" background="#f7f4ef"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="Heating and cooling: distribution by pressure zone" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=27;fontStyle=1;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1180" height="45" as="geometry"/></mxCell><mxCell id="subtitle" value="Paired arrows summarise supply and return | SC2 transfers heat across a separate pressure circuit" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Segoe UI;fontSize=15;fontStyle=0;fontColor=#242424;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="1180" height="36" as="geometry"/></mxCell><mxCell id="zone-source" value="&lt;b&gt;PC2 BUILDING LOOP&lt;/b&gt;&lt;br&gt;2 x S3 buffers (2,000 L each)&lt;br&gt;Common supply / return" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="220" height="110" as="geometry"/></mxCell><mxCell id="zone-p06" value="&lt;b&gt;P06&lt;/b&gt;&lt;br&gt;Communal-space branch&lt;br&gt;3 m3/h; 200 kPa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="220" height="110" as="geometry"/></mxCell><mxCell id="zone-common" value="&lt;b&gt;TOWER B COMMUNAL&lt;/b&gt;&lt;br&gt;Plant branch: 45/40 winter&lt;br&gt;8/13 deg C summer labels" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="950" y="150" width="250" height="110" as="geometry"/></mxCell><mxCell id="zone-p07" value="&lt;b&gt;P07 + MIXING&lt;/b&gt;&lt;br&gt;Low-pressure distribution&lt;br&gt;66 m3/h; 220 kPa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="430" y="345" width="220" height="110" as="geometry"/></mxCell><mxCell id="zone-low" value="&lt;b&gt;TOWERS A + B | BP&lt;/b&gt;&lt;br&gt;Low-pressure residential outlets&lt;br&gt;Apartment modules downstream" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#242424;fontFamily=Segoe UI;